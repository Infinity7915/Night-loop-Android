<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <!-- Android 8.0: gestures that continue (camera swipes) need API 26. -->
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <RootNamespace>NightLoop.Mobile</RootNamespace>
    <ApplicationId>win.nightloop.app</ApplicationId>
    <ApplicationTitle>Night-loop</ApplicationTitle>
    <!-- versionCode must go up with every release; versionName is what people see. -->
    <ApplicationVersion>501</ApplicationVersion>
    <ApplicationDisplayVersion>0.5.1</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <!-- Phones (32/64-bit ARM) and 64-bit emulators like MuMu. 32-bit x86 emulators are dropped to keep the .apk smaller. -->
    <RuntimeIdentifiers>android-arm;android-arm64;android-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <!-- Shared with the PC app and the server: macro rules, API client, macro engine core. -->
    <ProjectReference Include="..\..\external\night-loop\src\NightLoop.Contracts\NightLoop.Contracts.csproj" />
    <ProjectReference Include="..\..\external\night-loop\src\NightLoop.Client\NightLoop.Client.csproj" />
    <ProjectReference Include="..\..\external\night-loop\src\NightLoop.Engine\NightLoop.Engine.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Reads text on the screen on the phone itself, offline (Wait for text, Text visible). -->
    <PackageReference Include="Xamarin.Google.MLKit.TextRecognition" Version="116.0.1.9" />
  </ItemGroup>
</Project>
