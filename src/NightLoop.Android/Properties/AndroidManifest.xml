<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application android:label="Night-loop" android:icon="@drawable/ic_nightloop" android:allowBackup="false"
               android:fullBackupContent="false" android:dataExtractionRules="@xml/data_extraction_rules"
               android:usesCleartextTraffic="false"
               android:theme="@android:style/Theme.Material.NoActionBar">
    <!-- Home-screen icons: the normal one, and one per season (Settings › Seasonal themes switches them). -->
    <activity-alias android:name="win.nightloop.app.Launcher" android:targetActivity="win.nightloop.app.MainActivity" android:exported="true"
                    android:enabled="true" android:icon="@drawable/ic_nightloop" android:label="Night-loop">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity-alias>
    <activity-alias android:name="win.nightloop.app.Launcher_christmas" android:targetActivity="win.nightloop.app.MainActivity" android:exported="true"
                    android:enabled="false" android:icon="@drawable/ic_nightloop_christmas" android:label="Night-loop">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity-alias>
    <activity-alias android:name="win.nightloop.app.Launcher_newyear" android:targetActivity="win.nightloop.app.MainActivity" android:exported="true"
                    android:enabled="false" android:icon="@drawable/ic_nightloop_newyear" android:label="Night-loop">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity-alias>
    <activity-alias android:name="win.nightloop.app.Launcher_valentine" android:targetActivity="win.nightloop.app.MainActivity" android:exported="true"
                    android:enabled="false" android:icon="@drawable/ic_nightloop_valentine" android:label="Night-loop">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity-alias>
    <activity-alias android:name="win.nightloop.app.Launcher_stpatrick" android:targetActivity="win.nightloop.app.MainActivity" android:exported="true"
                    android:enabled="false" android:icon="@drawable/ic_nightloop_stpatrick" android:label="Night-loop">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity-alias>
    <activity-alias android:name="win.nightloop.app.Launcher_easter" android:targetActivity="win.nightloop.app.MainActivity" android:exported="true"
                    android:enabled="false" android:icon="@drawable/ic_nightloop_easter" android:label="Night-loop">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity-alias>
    <activity-alias android:name="win.nightloop.app.Launcher_july4" android:targetActivity="win.nightloop.app.MainActivity" android:exported="true"
                    android:enabled="false" android:icon="@drawable/ic_nightloop_july4" android:label="Night-loop">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity-alias>
    <activity-alias android:name="win.nightloop.app.Launcher_halloween" android:targetActivity="win.nightloop.app.MainActivity" android:exported="true"
                    android:enabled="false" android:icon="@drawable/ic_nightloop_halloween" android:label="Night-loop">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity-alias>
    <activity-alias android:name="win.nightloop.app.Launcher_thanksgiving" android:targetActivity="win.nightloop.app.MainActivity" android:exported="true"
                    android:enabled="false" android:icon="@drawable/ic_nightloop_thanksgiving" android:label="Night-loop">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity-alias>
    <activity-alias android:name="win.nightloop.app.Launcher_lunarnewyear" android:targetActivity="win.nightloop.app.MainActivity" android:exported="true"
                    android:enabled="false" android:icon="@drawable/ic_nightloop_lunarnewyear" android:label="Night-loop">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity-alias>
    <activity-alias android:name="win.nightloop.app.Launcher_midautumn" android:targetActivity="win.nightloop.app.MainActivity" android:exported="true"
                    android:enabled="false" android:icon="@drawable/ic_nightloop_midautumn" android:label="Night-loop">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity-alias>
  </application>
  <uses-permission android:name="android.permission.INTERNET" />
  <!-- The floating Night-loop bubble over other apps. -->
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
  <!-- Keeps the bubble (and later a running macro) alive, with a visible notification. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <!-- Screen-reading blocks (Wait for text / image): Android's screen capture, asked each session. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- Auto-update: hand a downloaded Night-loop update to Android's installer (you confirm it). -->
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
  <!-- Open app / Wait for app: see which apps have a home-screen icon (Android 11+ hides them otherwise). -->
  <queries>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
  </queries>
</manifest>
