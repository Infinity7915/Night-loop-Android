<Project>
  <!-- Only for this repo's own projects; the shared projects in external/night-loop use that repo's props. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Authors>Night-loop contributors</Authors>
    <Product>Night-loop</Product>
  </PropertyGroup>
</Project>
